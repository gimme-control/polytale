            "id": "launched",
            "when": {
              "fx.airship": "launched"
            },
            "image": "art/plate_launched.png"
          }
        ]
      }
    }
  },
  "npcs": [
    {
      "id": "npc.engineer",
      "name": "Hana",
      "role": "airship engineer",
      "persona": "Hana, the airship's engineer: capable, warm, and hurried by the incoming storm, but never impatient with the player. She communicates with very short Japanese lines, pointing, holding things up, offering them, and acting things out. She smiles when understood, glances at the sky when worried, and never explains grammar.",
      "english": "Knows only: okay, good, no, yes. She uses them rarely, only to avoid total breakdown.",
      "voice": {
        "elevenlabs_voice_id": "",
        "gemini_voice": "Kore",
        "style": "warm, clear, unhurried; natural standard Japanese pronunciation"
      },
