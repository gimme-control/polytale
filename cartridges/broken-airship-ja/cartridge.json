    "id": "broken-airship-ja",
    "name": "The Broken Airship",
    "tagline": "A storm is coming. The engineer speaks only Japanese. Help her get the airship off the ground.",
    "locale": "en-US"
  },
  "setting": {
    "premise": "A small hilltop airfield at dusk, with storm clouds rolling in fast. The player has just woken up beside a grounded wooden airship. Its engineer, Hana, must open the locked engine panel with the engine key and load the route map before the storm arrives. The player does not speak Japanese yet; Hana speaks almost no English. They can only succeed by communicating: she shows, points, and acts; the player asks for what is needed.",
    "location": {
      "id": "loc.airfield",
      "name": "Hilltop Airfield",
      "description": "A windswept grass airfield. A patched wooden airship is tethered beside a toolbox and a crate. The engine panel on the hull is shut with a keyhole. Dark clouds are gathering on the horizon.",
      "art": {
        "base": "art/plate_base.png",
        "variants": [
          {
            "id": "panel_open",
            "when": {
              "fx.engine_panel": "open"
            },
