# Required
GEMINI_API_KEY=
# DM model (typed tool loop)
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.5-flash-lite
# Art pipeline (scripts/generate_art.py only; never at runtime)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Fallback speech provider when ElevenLabs is not configured
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# ElevenLabs: primary TTS + STT for language mode. Blank = Gemini fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
# Force a provider: auto | elevenlabs | gemini
SPEECH_PROVIDER=auto

# Server
POLYTALE_PORT=8100

# Optional speech tuning
ELEVENLABS_DEFAULT_VOICE_ID=
GEMINI_STT_MODEL=gemini-3.5-flash
GEMINI_STT_FALLBACKS=gemini-3.5-flash-lite
GEMINI_STT_THINKING_LEVEL=minimal
